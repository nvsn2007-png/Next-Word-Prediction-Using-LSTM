import networkx as nx
import matplotlib.pyplot as plt

# Create the network graph
G = nx.Graph()

# Add devices and routers
nodes = ["PC", "R1", "R2", "R3", "R4", "Server"]
G.add_nodes_from(nodes)

# Add network connections
edges = [
    ("PC", "R1"),
    ("PC", "R3"),
    ("R1", "R2"),
    ("R3", "R4"),
    ("R2", "Server"),
    ("R4", "Server"),
    ("R1", "R3"),
    ("R2", "R4")
]

G.add_edges_from(edges)

# Find shortest path
path = nx.shortest_path(G, source="PC", target="Server")

print("\n======================================")
print(" NORMAL NETWORK SIMULATOR")
print("======================================")

print("\nNetwork Status: ONLINE")
print("Packet Route:")
print(" → ".join(path))

# Fixed positions
pos = {
    "PC": (0, 1),
    "R1": (1, 2),
    "R3": (1, 0),
    "R2": (3, 2),
    "R4": (3, 0),
    "Server": (4, 1)
}

# Create figure
plt.figure(figsize=(10, 6))

# Draw complete network
nx.draw(
    G,
    pos,
    with_labels=True,
    node_size=2500,
    node_color="lightblue",
    font_size=11,
    font_weight="bold",
    edge_color="gray",
    width=2
)

# Highlight packet route
path_edges = list(zip(path, path[1:]))

nx.draw_networkx_edges(
    G,
    pos,
    edgelist=path_edges,
    edge_color="green",
    width=5
)

plt.title(
    "Normal Network - Packet Transmission",
    fontsize=14,
    fontweight="bold"
)

plt.axis("off")
plt.show()